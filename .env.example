# Buka FIT — environment variables
# Copy to `.env.local` for local development.

# --- Public site URL (hreflang / canonical; no trailing slash) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Indexing (default ON = site closed from search engines until contract) ---
NEXT_PUBLIC_NOINDEX=true

# --- Lead → Telegram Bot API ---
# Development: use the developer's test bot + your personal chat_id.
# Before handoff to the club: replace with the club bot token and the
# manager chat / group chat_id. Never hardcode chat_id in source.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional override for local Bot API mocks (default: https://api.telegram.org)
# TELEGRAM_API_BASE=http://127.0.0.1:4099

# --- Maps (optional) ---
# Without these, «Показать карту» opens Google Maps in a new tab (never an empty iframe).
# Set NEXT_PUBLIC_MAPS_EMBED=yandex to load the public Yandex map-widget in-page,
# or set NEXT_PUBLIC_MAPS_API_KEY if you later switch to a keyed Google embed.
# NEXT_PUBLIC_MAPS_EMBED=yandex
# NEXT_PUBLIC_MAPS_API_KEY=

# --- Analytics (optional; scripts/events load only if set) ---
NEXT_PUBLIC_METRICA_ID=
NEXT_PUBLIC_GA_ID=
# Set true to log trackEvent to console without Metrica/GA IDs (acceptance / QA)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# --- Payments (stubs only; do not set until club provides merchant data) ---
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=
